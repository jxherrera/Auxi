# ==============================================================================
# AGROCACAO PRO / AUXI - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como .env para desarrollo local o para despliegue en servidor.
# No coloques credenciales ni secretos reales en este archivo de ejemplo.

# ------------------------------------------------------------------------------
# 1. ENTORNO DE DESARROLLO LOCAL (Ejecución directa en host con npm run dev / server)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=5173

# En desarrollo local la API corre en localhost:3001 y el frontend Vite en localhost:5173
VITE_API_URL=http://localhost:3001/api
CORS_ORIGIN=http://localhost:5173

# Base de datos SQLite local
DATABASE_PATH=server/data/agrocacao.db
DATA_DIR=server/data

# ------------------------------------------------------------------------------
# 2. ENTORNO DE PRODUCCIÓN (Oracle Cloud Always Free + Docker Compose + Nginx + Cloudflare)
# ------------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3001
# FRONTEND_PORT=80

# En producción, Nginx actúa como reverse proxy (/api -> backend:3001), por lo que el frontend usa ruta relativa /api
# VITE_API_URL=/api

# Ruta de la base de datos persistente montada en el volumen Docker (/app/data/agrocacao.db)
# DATABASE_PATH=/app/data/agrocacao.db
# DATA_DIR=/app/data

# Origen permitido de CORS (Reemplaza con tu dominio real configurado en Cloudflare Tunnel)
# Ejemplo: https://app.tudominio.com o https://auxi.tudominio.com
# CORS_ORIGIN=https://app.tudominio.com

